{
  // Redirect-only Worker for www.riddim.love (deploy: npm run deploy:www).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "riddim-love-www",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "www.riddim.love", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": false }
}
