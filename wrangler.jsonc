{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riddim-love",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // All app state lives in the query string on "/", so no SPA fallback:
    // a missing /assets/* file must 404, never return index.html (which the
    // immutable cache header would otherwise pin in browsers).
    "not_found_handling": "404-page",
    // "/" (the HTML shell) runs the Worker for redirects + robots headers;
    // /assets/*, /og.png, /robots.txt, /sitemaps/*.xml stay pure static.
    // /sitemap.xml runs the Worker only to fall back: it serves the pre-built
    // file (`npm run sitemap`) and builds the small one if that is missing.
    "run_worker_first": ["/api/*", "/", "/sitemap.xml", "/riddim/*", "/artist/*", "/producer/*", "/label/*", "/tune/*", "/want"]
  },
  "routes": [{ "pattern": "riddim.love", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
